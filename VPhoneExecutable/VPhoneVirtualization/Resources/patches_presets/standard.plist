<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The preset every VM gets unless another is named.

  It draws on every patch set the bundle ships and turns on all of their patches
  bar two pairs. The Frida Stalker pair widens what any process in the guest may do
  and nothing needs it in order to boot. The hv_vmm_present pair — the kernel OID
  rename and the shared-cache mangle — leaves a freshly restored 26.4 guest on a
  black screen: bluetoothd caches the failed sysctl lookup, crash-loops, and the
  data migrator SpringBoard waits on never finishes. Each pair is all-or-nothing;
  see FirmwareKernelHypervisorPatchSet for the whole chain.

  Each patch's own version gate still decides whether it lands on this pairing of
  iPhone base and cloudOS.

  Prewritten and reviewed. Nothing in the tool edits a preset: a VM records which
  boxes its owner changed, and those compose on top of this.

  FirmwarePatchSetCatalog.standardPreset is the in-code copy a dev build without a
  staged bundle falls back to. FirmwarePatchSetTests checks the two agree.
-->
<plist version="1.0">
<dict>
	<key>Identifier</key>
	<string>standard</string>
	<key>Title</key>
	<string>Standard</string>
	<key>Summary</key>
	<string>The patches every vphone VM needs to boot, jailbroken, with a working display and camera.</string>
	<key>PatchSets</key>
	<array>
		<dict>
			<key>Kind</key>
			<string>Bundled</string>
			<key>Identifier</key>
			<string>com.vphone.patchset.bootchain</string>
		</dict>
		<dict>
			<key>Kind</key>
			<string>Bundled</string>
			<key>Identifier</key>
			<string>com.vphone.patchset.kernel.base</string>
		</dict>
		<dict>
			<key>Kind</key>
			<string>Bundled</string>
			<key>Identifier</key>
			<string>com.vphone.patchset.kernel.jailbreak</string>
		</dict>
		<dict>
			<key>Kind</key>
			<string>Bundled</string>
			<key>Identifier</key>
			<string>com.vphone.patchset.kernel.hypervisor</string>
		</dict>
		<dict>
			<key>Kind</key>
			<string>Bundled</string>
			<key>Identifier</key>
			<string>com.vphone.patchset.kernel.frida</string>
		</dict>
		<dict>
			<key>Kind</key>
			<string>Bundled</string>
			<key>Identifier</key>
			<string>com.vphone.patchset.devicetree</string>
		</dict>
		<dict>
			<key>Kind</key>
			<string>Bundled</string>
			<key>Identifier</key>
			<string>com.vphone.patchset.guest.system</string>
		</dict>
		<dict>
			<key>Kind</key>
			<string>Bundled</string>
			<key>Identifier</key>
			<string>com.vphone.patchset.guest.display</string>
		</dict>
		<dict>
			<key>Kind</key>
			<string>Bundled</string>
			<key>Identifier</key>
			<string>com.vphone.patchset.guest.identity</string>
		</dict>
	</array>
	<key>Selection</key>
	<dict>
		<key>Kind</key>
		<string>Block</string>
		<key>Patches</key>
		<array>
			<string>kernelcache_frida.thread_set_state_entitlement_flag</string>
			<string>kernelcache_frida.vm_map_delete_immutable_code</string>
			<string>kernelcache_exp.hv_vmm</string>
			<string>hv_vmm_dsc</string>
		</array>
	</dict>
</dict>
</plist>
