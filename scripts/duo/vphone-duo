#!/usr/bin/env python3
"""Drive a running iPhone Duo VM over its host control socket.

  vphone-duo fold                    print the hinge angle and lit panel
  vphone-duo fold 87.5               set the hinge angle exactly (0 closed, 180 open flat)
  vphone-duo fold laptop [--animate] closed, tent, laptop or open
  vphone-duo press side [--ms 800]   press a button: volume_up, volume_down, side, camera_control
  vphone-duo finish black            white or black
  vphone-duo shot out.png            full-resolution screenshot
  vphone-duo rpc METHOD [JSON]       any vphoned method
  vphone-duo signin allow|block      let apps launched from now on show Apple Account
                                     sign-in, for signing in to iCloud yourself;
                                     block puts the research guest's suppression back
  vphone-duo appearance dark|light   iOS's appearance (the window's Space Black and
                                     Star White set it too)
  vphone-duo setup dev               Developer Mode, Setup Assistant skipped, Auto-Lock Never
  vphone-duo setup jb [--manager sileo|zebra] [--ssh-key ~/.ssh/id_ed25519.pub]
                                     dev, the Irisin bootstrap, then a package manager
                                     and your SSH key; see Documents/Guides/duo-setups.md
  vphone-duo setup custom FILE.json  any of those, from a file
  vphone-duo setup status            what the guest has
  vphone-duo panel inner|cover       boot on the inner or the cover panel (machine
                                     stopped); see Documents/Guides/iphone-duo.md

The VM is found by name under ~/.vphone/machines (default "duo"); pass
--vm NAME or --socket PATH to pick another.
"""
import argparse
import json
import os
import socket
import sys


def call(sock_path, request):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.settimeout(120)
        s.connect(sock_path)
        s.sendall((json.dumps(request) + "\n").encode())
        data = b""
        while not data.endswith(b"\n"):
            chunk = s.recv(1 << 16)
            if not chunk:
                break
            data += chunk
    reply = json.loads(data or b"{}")
    reply.pop("image", None)
    return reply


SIGNIN_MARKER = "/var/mobile/Library/Preferences/com.vphone.signin-allowed"


def signin(path, choice):
    """The guest suppresses Apple Account sign-in sheets, having no account;
    a marker lets apps launched after it show them again."""
    def rpc(method, params):
        reply = call(path, {"t": "rpc", "method": method, "params": params, "screen": False})
        return reply.get("ok"), reply
    if choice == "allow":
        ok, reply = rpc("files.write", {"path": SIGNIN_MARKER, "content": "allowed by vphone-duo\n"})
        if not ok:
            raise SystemExit(f"could not allow sign-in: {reply.get('error')}")
        rpc("apps.terminate", {"bundle_id": "com.apple.Preferences"})
        print("sign-in allowed: open Settings > Apple Account and sign in yourself")
    elif choice == "block":
        rpc("files.remove", {"path": SIGNIN_MARKER})
        rpc("apps.terminate", {"bundle_id": "com.apple.Preferences"})
        print("sign-in sheets suppressed again for apps launched from now on")
    else:
        ok, reply = rpc("files.list", {"path": "/var/mobile/Library/Preferences"})
        names = [e.get("name") for e in (reply.get("result") or {}).get("entries", [])] if ok else []
        print("allowed" if SIGNIN_MARKER.rsplit("/", 1)[1] in names else "blocked")


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--vm", default="duo")
    parser.add_argument("--socket")
    parser.add_argument("command", choices=["fold", "press", "finish", "shot", "rpc", "signin", "appearance", "setup", "panel"])
    parser.add_argument("args", nargs=argparse.REMAINDER)
    parser.add_argument("--animate", action="store_true")
    parser.add_argument("--ms", type=int, default=120)
    options = parser.parse_args()
    path = options.socket or os.path.expanduser(f"~/.vphone/machines/{options.vm}/vphone.sock")

    if options.command == "panel":
        if not options.args or options.args[0] not in ("inner", "cover"):
            parser.error("panel needs inner or cover")
        sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
        import duo_panel
        duo_panel.switch(options.vm, options.args[0])
        return

    if options.command in ("appearance", "setup"):
        sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
        import duo_setup
        duo_setup.run(call, path, (["appearance"] if options.command == "appearance" else []) + options.args)
        return

    request = {"screen": False}
    if options.command == "fold":
        request["t"] = "fold"
        if options.args:
            value = options.args[0]
            try:
                angle = float(value)
            except ValueError:
                request["posture"] = value
            else:
                if not 0 <= angle <= 180:
                    parser.error("the angle runs from 0 (closed) to 180 (open flat)")
                request["angle"] = angle
            request["animate"] = options.animate
    elif options.command == "press":
        if not options.args:
            parser.error("press needs a key: volume_up, volume_down, side or camera_control")
        request.update(t="duo", button=options.args[0], ms=options.ms)
    elif options.command == "finish":
        request.update(t="duo", finish=options.args[0])
    elif options.command == "shot":
        request.update(t="screenshot", path=os.path.abspath(options.args[0] if options.args else "duo.png"))
    elif options.command == "rpc":
        request.update(t="rpc", method=options.args[0], params=json.loads(options.args[1]) if len(options.args) > 1 else {})

    if options.command == "signin":
        signin(path, options.args[0] if options.args else "status")
        return
    reply = call(path, request)
    print(json.dumps(reply, indent=2))
    sys.exit(0 if reply.get("ok") else 1)


if __name__ == "__main__":
    main()
